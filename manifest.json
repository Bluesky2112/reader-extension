{
  "manifest_version": 3,
  "name": "Read Aloud Lite",
  "version": "2.1",
  "description": "Highlight any text on any website and click a button to hear it read aloud instantly.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}